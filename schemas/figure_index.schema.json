{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://archaeopairs/schemas/figure_index.schema.json",
  "title": "figure_index",
  "description": "A0 产物：DocBook figure 索引。每个 figure 一条。",
  "type": "object",
  "required": ["book_id", "figure_id", "fileref", "figure_no", "case_pred", "caption_mode"],
  "additionalProperties": false,
  "properties": {
    "book_id": { "type": "string", "description": "报告唯一标识，如 baidicheng" },
    "figure_id": { "type": "string", "pattern": "^fig-\\d+$", "description": "figure 全局唯一 id，如 fig-0001" },
    "fileref": { "type": "string", "pattern": "^media/.*\\.(jpg|png)$", "description": "相对 media 路径，须存在性校验" },
    "contentwidth": { "type": "integer", "minimum": 1 },
    "contentdepth": { "type": "integer", "minimum": 1 },
    "figure_no": {
      "type": "object", "required": ["norm", "original"], "additionalProperties": false,
      "properties": {
        "norm": { "type": "string", "description": "归一图号，中文数字→阿拉伯，后缀保留，如 七 / 2-1-16b" },
        "original": { "type": "string", "description": "图题原始图号文本，如图七 / 图2-1-16b" }
      }
    },
    "caption": { "type": ["string", "null"], "description": "图题全文（图号+描述）" },
    "note_refs": { "type": "array", "items": { "type": "string" }, "description": "紧邻 figure-note para 的内容引用" },
    "section": { "type": ["string", "null"], "description": "所在章节 sect1" },
    "page": { "type": ["string", "null"] },
    "case_pred": { "enum": ["case1", "case2", "unknown"], "description": "case1=图内完整(含图题/图注/比例尺); case2=图内仅线图+序号+比例尺" },
    "caption_mode": { "enum": ["artifact", "plate", "non", "uncertain"], "description": "A0 图题先验分流预计算：artifact 候选器物图；plate 彩板；non 否决；uncertain 待 VLM" },
    "schema_drift": { "type": ["string", "null"], "description": "schema 漂移探测告警，无则 null" }
  },
  "examples": [{
    "book_id": "baidicheng", "figure_id": "fig-0025", "fileref": "media/image25.jpg",
    "contentwidth": 667, "contentdepth": 618,
    "figure_no": { "norm": "二十", "original": "图二○" },
    "caption": "图二○ 白帝庙遗址地层出土宋代瓷器、缸胎器",
    "note_refs": ["1.瓷碗(M4:2) 2.缸胎器(M4:4) ..."],
    "section": "白帝庙遗址", "page": "98", "case_pred": "case2", "caption_mode": "artifact", "schema_drift": null
  }]
}
