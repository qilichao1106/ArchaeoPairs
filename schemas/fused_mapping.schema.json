{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://archaeopairs/schemas/fused_mapping.schema.json",
  "title": "fused_mapping",
  "description": "A4 产物：三源(seq键)对齐后的融合映射，A5 分割与 A7 组装的输入。",
  "type": "object",
  "required": ["figure_id", "case_type", "seq_to_id", "per_elem_provenance", "confidence"],
  "additionalProperties": false,
  "properties": {
    "figure_id": { "type": "string", "pattern": "^fig-\\d+$" },
    "case_type": { "enum": ["rule_a", "rule_b"], "description": "rule_a=多物体图(按seq拆); rule_b=单物体多局部图(同器物号合并)" },
    "seq_to_id": { "type": "object", "patternProperties": { "^\\d+$": { "type": "array", "items": { "type": "string" } } } },
    "per_elem_provenance": {
      "type": "object", "patternProperties": { "^\\d+$": { "type": "object", "required": ["source", "agents", "confidence"], "additionalProperties": false,
        "properties": {
          "source": { "enum": ["both", "note_only", "body_only", "ocr_only", "vlm_arbitrated", "unresolvable"] },
          "agents": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": ["string", "null"] }
        } } }
    },
    "conflict_flags": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "整体=min(要素置信)加权差集惩罚" },
    "review_flag": { "type": "boolean" }
  },
  "examples": [{
    "figure_id": "fig-0025", "case_type": "rule_a",
    "seq_to_id": { "1": ["M4-2"], "2": ["M4-4"] },
    "per_elem_provenance": {
      "1": { "source": "both", "agents": ["A1a", "A1b"], "confidence": 0.95, "reason": null },
      "2": { "source": "both", "agents": ["A1a", "A1b"], "confidence": 0.95, "reason": null }
    },
    "conflict_flags": [], "confidence": 0.95, "review_flag": false
  }]
}
