{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://archaeopairs/schemas/text_side.schema.json",
  "title": "text_side",
  "description": "A1c 产物：按 figure 聚合的文本侧证据（图注链① + 正文链②）。",
  "type": "object",
  "required": ["figure_id", "seq_set", "seq_to_id", "id_to_desc", "degraded", "note_provenance"],
  "additionalProperties": false,
  "properties": {
    "figure_id": { "type": "string", "pattern": "^fig-\\d+$" },
    "seq_set": { "type": "array", "items": { "type": "string", "pattern": "^\\d+$" }, "description": "图内序号集合" },
    "seq_to_id": {
      "type": "object", "patternProperties": { "^\\d+$": { "type": "array", "items": { "type": "string" } } },
      "description": "seq → 器物号列表；同号式可多 id；范围式展开后每个 seq 独立键"
    },
    "id_to_desc": {
      "type": "object",
      "patternProperties": { "^[A-Z0-9]+-[0-9]+$": { "type": "string" } },
      "description": "artifact_id(归一化) → 正文按器物号切分的单件描述文本。切分边界=相邻器物号 token 之间。图注/图题不并入，归图像元数据。"
    },
    "degraded": { "type": "boolean", "description": "true=仅单源成功或 LLM 兜底" },
    "note_provenance": { "enum": ["figure_note", "ocr", "mixed", "body_only"], "description": "seq_to_id 来源" },
    "conflicts": { "type": "array", "items": { "type": "object", "required": ["seq", "note_id", "body_id"], "additionalProperties": false,
      "properties": { "seq": { "type": "string" }, "note_id": { "type": "array", "items": { "type": "string" } }, "body_id": { "type": "array", "items": { "type": "string" } } } } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "examples": [{
    "figure_id": "fig-0025", "seq_set": ["1", "2"],
    "seq_to_id": { "1": ["M4-2"], "2": ["M4-4"] },
    "id_to_desc": { "M4-2": "瓷碗，敞口，口径12cm，足径5cm", "M4-4": "缸胎器，残高8cm" },
    "degraded": false, "note_provenance": "figure_note", "conflicts": [], "confidence": 0.95
  }]
}
